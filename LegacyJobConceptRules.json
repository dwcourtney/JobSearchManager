      "userConfigurable": false,
      "workLocationLevel": 5
    },
    {
      "id": "work.travel.occasional",
      "displayName": "Occasional Travel",
      "category": "Work Arrangement",
      "definition": "Occasional or limited work travel, generally no more than about 10 percent.",
      "evidencePatterns": [
        "\\b(?:occasional|limited)\\s+travel\\b",
        "\\btravel\\s*,?\\s+as\\s+needed\\b",
        "\\btravel\\b[^.!?]{0,80}\\btypically\\s+lasting\\s+no\\s+more\\s+than\\s+one\\s+week\\b",
        "\\bat\\s+most\\s+one\\s+(?:short\\s+)?trip\\s+every\\s+(?:2\\s*[-–—]\\s*3|two\\s+to\\s+three)\\s+years?\\b",
        "\\b(?:one|1)\\s+(?:short\\s+)?trip\\s+every\\s+(?:12\\s*[-–—]\\s*18|twelve\\s+to\\s+eighteen)\\s+months?\\b",
        "\\b(?:[0-9]|10)\\s*%(?!\\s*(?:-|–|—|to)\\s*\\d)\\s+travel\\b",
        "\\btravel\\b[^.!?]{0,30}\\b(?:[0-9]|10)\\s*%(?!\\s*(?:-|–|—|to)\\s*\\d)"
