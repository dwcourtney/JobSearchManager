{
  "JobSource": {
    "PageSize": 20,
    "DetailConcurrency": 3,
    "RequestTimeoutSeconds": 30,
    "MaximumListingPages": 200,
    "MaximumDetailRequestsPerRefresh": 200,
    "MaximumAutomaticDetailRequests": 50,
    "MaximumRevalidationsPerRefresh": 25,
    "DetailReuseHours": 168
  },
  "Application": {
    "OpenBrowser": true,
    "RefreshOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
