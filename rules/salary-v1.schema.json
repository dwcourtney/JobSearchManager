{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Salary parsing rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesetVersion",
    "regexTimeoutMilliseconds",
    "patterns",
    "unparseablePhrases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rulesetVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "regexTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern",
          "ignoreCase",
          "cultureInvariant"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "ignoreCase": {
            "type": "boolean"
          },
          "cultureInvariant": {
            "type": "boolean"
          }
        }
      }
    },
    "unparseablePhrases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
