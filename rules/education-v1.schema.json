{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobsearchmanager.local/schemas/education-v1.schema.json",
  "title": "JSM education rules, schema version 1",
  "description": "The runtime additionally validates globally unique IDs, priorities within each ordered group, scope-correct references, named capture groups, conditional pairs, specific-degree/level compatibility and absence of unreferenced patterns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesetVersion",
    "regexTimeoutMilliseconds",
    "patterns",
    "degreeRules",
    "abbreviations",
    "qualifierRules",
    "sectionRules",
    "accreditation",
    "relatedFieldResult"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rulesetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "regexTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "pattern",
          "scope",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "regex"
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "scope": {
            "enum": [
              "segment",
              "html",
              "text",
              "tail",
              "field",
              "connector",
              "context",
              "window",
              "token"
            ]
          },
          "options": {
            "enum": [
              [],
              [
                "IgnoreCase",
                "CultureInvariant"
              ]
            ]
          }
        }
      }
    },
    "degreeRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patternId",
          "priority",
          "level",
          "specificDegree"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "patternId": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "level": {
            "enum": [
              "highSchool",
              "associate",
              "bachelor",
              "master",
              "doctorate"
            ]
          },
          "specificDegree": {
            "enum": [
              null,
              "phD"
            ]
          }
        }
      }
    },
    "abbreviations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "normalizationPatternId",
        "captureGroup",
        "levels"
      ],
      "properties": {
        "patternId": {
          "type": "string",
          "minLength": 1
        },
        "normalizationPatternId": {
          "type": "string",
          "minLength": 1
        },
        "captureGroup": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z]{1,32}$"
          },
          "additionalProperties": {
            "enum": [
              "highSchool",
              "associate",
              "bachelor",
              "master",
              "doctorate"
            ]
          }
        }
      }
    },
    "qualifierRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patternId",
          "priority",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "patternId": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "result": {
            "enum": [
              "required",
              "minimum",
              "preferred",
              "desired",
              "mentioned"
            ]
          }
        }
      }
    },
    "sectionRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patternId",
          "priority",
          "result",
          "conditionalPatternId",
          "conditionalResult"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "patternId": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "result": {
            "enum": [
              "required",
              "minimum",
              "preferred",
              "desired",
              "mentioned"
            ]
          },
          "conditionalPatternId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "conditionalResult": {
            "enum": [
              null,
              "required",
              "minimum",
              "preferred",
              "desired",
              "mentioned"
            ]
          }
        }
      }
    },
    "accreditation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "name",
        "requirementRules"
      ],
      "properties": {
        "patternId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "requirementRules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patternId",
              "priority",
              "result"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "patternId": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "result": {
                "enum": [
                  "required",
                  "minimum",
                  "preferred",
                  "desired",
                  "mentioned"
                ]
              }
            }
          }
        }
      }
    },
    "relatedFieldResult": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
