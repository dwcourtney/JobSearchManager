      "unit": "years",
      "kind": "range"
    },
    {
      "id": "education-experience-short",
      "domain": "education",
      "type": "experience",
      "pattern": "(?:\\+|plus)\\s*(?<lower>\\d+)\\s*(?<unit>years?)\\b",
      "code": null,
      "unit": "years",
      "kind": "range"
    },
    {
      "id": "education-negation",
      "domain": "education",
      "type": "absence",
      "pattern": "\\b(?<value>no\\s+degree\\s+(?:is\\s+)?required|degree\\s+(?:is\\s+)?not\\s+required)\\b",
      "code": "no-degree-required",
      "unit": null,
      "kind": "categorical"
    },
    {
      "id": "education-substitution",
      "domain": "education",
      "type": "substitution",
      "pattern": "\\b(?<value>in\\s+lieu\\s+of|instead\\s+of|equivalent\\s+(?:experience|combination))\\b",
      "code": "experience-substitution",
      "unit": null,
      "kind": "categorical"
    },
    {
