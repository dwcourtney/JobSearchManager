{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobsearchmanager.local/rules/geographic-restriction-v1.schema.json",
  "title": "JSM geographic restriction rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesetVersion",
    "regexTimeoutMilliseconds",
    "patterns",
    "remoteDesignationCues",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rulesetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "regexTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    },
    "remoteDesignationCues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryLocation",
        "additionalLocation",
        "description"
      ],
      "properties": {
        "primaryLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "additionalLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "patternId",
          "category",
          "unlessPatternIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "patternId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "category": {
            "enum": [
              "distance-radius",
              "commuting-distance",
              "hybrid-local",
              "required-region",
              "regional-preference"
            ]
          },
          "unlessPatternIds": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      }
    }
  }
}
