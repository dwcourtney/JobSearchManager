{
  "schemaVersion": 1,
  "version": "1.0.0",
  "timeoutMilliseconds": 250,
  "clauseBoundary": ";\\s*|(?<=[.!?])\\s+(?=[A-Z])|,\\s*(?=(?:TS(?:/SCI)?|Top Secret|Secret|Master|Bachelor)\\b)",
  "alternativeBoundary": "\\s+OR\\s+",
  "required": "\\b(?:required|must|mandatory|shall)\\b",
  "preferred": "\\b(?:preferred|desired)\\b",
  "optional": "\\b(?:may|possible|optional|eligible)\\b",
  "negated": "\\b(?:no\\s+\\w+(?:\\s+\\w+){0,2}\\s+required|not\\s+required|not\\s+available|excluded|excluding)\\b",
  "temporal": "\\b(?:before\\s+(?:start|hire)|after\\s+(?:hire|training|start)|within\\s+\\d+\\s+(?:days?|months?|weeks?)|long[- ]term|temporary)\\b",
  "section": "^(?:required|minimum|basic|preferred|desired)\\s+(?:qualifications|education|skills)\\s*:?",
  "numbers": {
    "one": 1,
    "two": 2,
    "three": 3,
    "four": 4,
    "five": 5,
    "six": 6,
    "seven": 7,
    "eight": 8,
    "nine": 9,
    "ten": 10,
    "eleven": 11,
    "twelve": 12,
    "ninety": 90
  },
  "patterns": [
    {
      "id": "clearance-level",
      "domain": "clearance",
      "type": "level",
      "pattern": "\\b(?<value>TS\\s*/\\s*SCI|Top\\s+Secret(?:\\s*/\\s*SCI)?|Secret|TS|Public\\s+Trust)\\b",
      "code": null,
      "unit": null,
      "kind": "categorical"
    },
    {
      "id": "clearance-negation",
      "domain": "clearance",
      "type": "absence",
      "pattern": "\\b(?<value>no\\s+(?:security\\s+)?clearance\\s+(?:is\\s+)?required|clearance\\s+(?:is\\s+)?not\\s+required)\\b",
      "code": "no-clearance-required",
      "unit": null,
      "kind": "categorical"
    },
    {
      "id": "clearance-obtain",
      "domain": "clearance",
      "type": "acquisition",
      "pattern": "\\b(?<value>ability\\s+to\\s+obtain|able\\s+to\\s+obtain|may\\s+be\\s+obtained|obtain(?:ed)?)\\b",
      "code": "obtainable",
      "unit": null,
      "kind": "categorical"
    },
    {
      "id": "clearance-active",
