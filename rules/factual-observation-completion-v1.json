      "code": null,
      "unit": null,
      "kind": "surface-destination",
      "contextPattern": "\\b(?:deploy(?:ment|ed)?|assignments?|rotations?|OCONUS|CONUS|domestic|international|customer\\s+site|away|winter[- ]over|relocation)\\b"
    },
    {
      "id": "assignment-territory",
      "domain": "extended-location",
      "type": "territory",
      "pattern": "\\b(?<value>domestic|international|OCONUS|CONUS)\\b",
      "code": null,
      "unit": null,
      "kind": "categorical",
      "contextPattern": "\\b(?:deploy(?:ment|ed)?|assignments?|rotations?|OCONUS|CONUS|domestic|international|customer\\s+site|away|winter[- ]over|relocation)\\b"
    },
    {
      "id": "assignment-duration",
      "domain": "extended-location",
      "type": "duration",
      "pattern": "\\b(?<lower>\\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|ninety)\\s*(?:(?:[-\u2013\u2014]|to)\\s*(?<upper>\\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|ninety))?(?:\\s+(?<qualifier>consecutive))?\\s*[- ]?\\s*(?<unit>days?|weeks?|months?|years?)\\b",
      "code": null,
      "unit": null,
      "kind": "range",
      "contextPattern": "\\b(?:deploy(?:ment|ed)?|assignments?|rotations?|OCONUS|CONUS|domestic|international|customer\\s+site|away|winter[- ]over|relocation)\\b"
    },
    {
      "id": "assignment-recurrence",
      "domain": "extended-location",
      "type": "recurrence",
      "pattern": "\\b(?<value>rotations?|rotating|winter[- ]over|recurring|annually|quarterly)\\b",
      "code": null,
      "unit": null,
      "kind": "categorical",
      "contextPattern": "\\b(?:deploy(?:ment|ed)?|assignments?|rotations?|OCONUS|CONUS|domestic|international|customer\\s+site|away|winter[- ]over|relocation)\\b"
    },
    {
      "id": "geography-inclusion",
      "domain": "geographic-restriction",
      "type": "included-jurisdiction",
      "pattern": "\\b(?:must\\s+(?:reside|live)\\s+in|remote\\s+(?:within|from)|(?:based|located)\\s+in)\\s+(?<value>[^.;]{1,140}?)(?=\\s+(?:only|and\\s+(?:must|be|have))|[.;]|$)",
      "code": null,
      "unit": null,
      "kind": "surface-jurisdiction-list"
    },
    {
      "id": "geography-exclusion",
      "domain": "geographic-restriction",
      "type": "excluded-jurisdiction",
      "pattern": "\\b(?:not\\s+available\\s+in|excluding|except(?:\\s+for)?)\\s+(?<value>[^.;]{1,140}?)(?=[.;]|$)",
      "code": null,
      "unit": null,
      "kind": "surface-jurisdiction-list"
    },
    {
      "id": "geography-excluded-after",
      "domain": "geographic-restriction",
      "type": "excluded-jurisdiction",
      "pattern": "\\bcandidates\\s+in\\s+(?<value>[^.;]{1,140}?)\\s+(?:states?\\s+)?(?:are\\s+)?excluded\\b",
      "code": null,
      "unit": null,
