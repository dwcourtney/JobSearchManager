{
  "schemaVersion": 1,
  "rulesetVersion": "1.0.0",
  "regexTimeoutMilliseconds": 1000,
  "patterns": [
    {
      "id": "RemoteDesignationPattern",
      "type": "regex",
      "scope": "metadata",
      "pattern": "\\b(?:remote|telework(?:er)?|telecommut(?:e|er|ing)|work(?:ing)?\\s+(?:from|at)\\s+home|home[- ]based|WFH|virtual)\\b"
    },
    {
      "id": "ExplicitRemoteRolePattern",
      "type": "regex",
      "scope": "plainText",
      "pattern": "\\bthis\\s+(?:position|role)\\s+is\\s+(?:a\\s+)?(?:U\\.?S\\.?\\s+)?(?:fully\\s+)?remote(?:[- ]telework)?\\b|\\bthis\\s+is\\s+(?:a\\s+)?(?:U\\.?S\\.?\\s+)?remote[- ]telework\\s+role\\b|\\bthis\\s+position\\b.{0,140}\\bfollows\\s+a\\s+remote\\s+work\\s+schedule\\b"
    },
    {
      "id": "BlockEndPattern",
      "type": "regex",
      "scope": "html",
      "pattern": "</(?:p|li|div|h[1-6])\\s*>|<br\\s*/?>"
    },
    {
      "id": "SentenceSplitPattern",
      "type": "regex",
      "scope": "plainText",
      "pattern": "(?<=[.!?])\\s+(?=[A-Z0-9#*])"
    },
    {
      "id": "WhitespacePattern",
      "type": "regex",
      "scope": "evidence",
      "pattern": "\\s+"
    },
    {
      "id": "HistoricalExperiencePattern",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:prior|previous|demonstrated|relevant)?\\s*experience\\s+(?:working|supporting|performing|conducting|at|in|with)\\b|\\b(?:familiarity|knowledge|background)\\s+(?:with|of|in)\\b"
    },
    {
      "id": "CurrentObligationPattern",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:must|required|requires?|will|shall|responsib(?:le|ilities)|you(?:'|\\u2019)?ll|this\\s+(?:position|role)|provide|perform|conduct|support|lead|assist|serve|deploys?)\\b"
    },
    {
      "id": "TravelPercentagePattern",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?<minimum>\\d{1,3})\\s*%\\s*(?:(?:-|\\u2013|\\u2014|to)\\s*(?<maximum>\\d{1,3})\\s*%)?\\s+travel\\b|\\btravel\\b[^.!?]{0,30}?\\b(?<minimum>\\d{1,3})\\s*%\\s*(?:(?:-|\\u2013|\\u2014|to)\\s*(?<maximum>\\d{1,3})\\s*%)?"
    },
    {
      "id": "FrequentTravelPattern",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:requires?\\s+(?:the\\s+ability\\s+to\\s+)?travel\\s+frequently|frequent\\s+travel|travel\\s+frequently|extensive\\s+travel)\\b"
    },
    {
      "id": "TentativePresencePattern",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:a\\s+possibility|periodic(?:ally)?|may\\s+be\\s+required|as[- ]needed\\s+basis)\\b"
    },
    {
      "id": "signal-scheduled-onsite",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:work|be|spend|report|in[- ]person).{0,70}\\b(?:one|two|three|four|five|[1-5])\\s*(?:-|\\u2013)?\\s*days?\\s+(?:a|per)\\s+week\\b.{0,70}\\b(?:on[- ]?site|in[- ]person|office|facility)\\b|\\b(?:one|two|three|four|five|[1-5])\\s*(?:-|\\u2013)?\\s*days?\\s+(?:a|per)\\s+week\\b.{0,70}\\b(?:on[- ]?site|in[- ]person|office|facility)\\b"
    },
    {
      "id": "signal-onsite-duty",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:provide|perform|serve\\s+as|lead|maintain).{0,45}\\bon[- ]?site\\b|\\b(?:work|be|report|role\\s+(?:deploys|requires)|position\\s+requires).{0,65}\\b(?:on[- ]?site|in[- ]person)\\b|\\bon[- ]?site\\b.{0,80}\\b(?:support|activities|work|monitoring|consultation|deployment|duration)\\b"
    },
    {
      "id": "signal-field-deployment",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:conduct|perform|support|assist|lead|manage).{0,55}\\b(?:field\\s+(?:deployment|testing|operations?|integration)|operational\\s+(?:testing|validation))\\b|\\bfield\\s+deployment\\s+support\\b"
    },
    {
      "id": "signal-physical-installation",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:support|perform|lead|manage|responsible\\s+for).{0,65}\\b(?:installation\\s+and\\s+activation|installation\\s+of\\s+(?:physical\\s+)?(?:sensing\\s+systems?|equipment)|delivery\\s+and\\s+removal\\s+of\\s+.+?equipment|deploy(?:ment|ing)\\s+and\\s+activation)\\b"
    },
    {
      "id": "signal-operational-site",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:work|serve|deploy|support|assist|conduct|perform).{0,70}\\b(?:Army|DoD|military)\\s+(?:installations?|depots?|arsenals?)\\b|\\b(?:work|serve|deploy|support|assist|conduct|perform).{0,70}\\b(?:operational\\s+test\\s+ranges?|manufacturing\\s+facilit(?:y|ies)|airport\\s+locations?|laborator(?:y|ies))\\b"
    },
    {
      "id": "signal-commuting-area",
      "type": "regex",
      "scope": "sentence",
      "pattern": "\\b(?:must|required\\s+to|ideal(?:ly)?\\s+candidate\\s+(?:would|should)\\s+be|candidates?\\s+must)\\b.{0,100}\\b(?:within\\s+(?:a\\s+)?(?:reasonable\\s+)?commuting\\s+distance|within\\s+\\d{1,3}\\s+miles?|within\\s+driving\\s+distance|\\d{1,2}\\s*hour\\s+radius|greater\\s+.+?\\s+area)\\b|\\b(?:candidates?\\s+)?(?:will\\s+need|need)\\s+to\\s+be\\b.{0,70}\\bcommutable\\s+distance\\b|\\bmust\\s+live\\s+within\\s+driving\\s+distance\\b|\\bif\\s+you\\s+live\\s+within\\s+(?:a\\s+)?reasonable\\s+commute\\b.{0,160}\\bonsite\\s+presence\\b"
    }
  ],
  "signalRules": [
    {
      "id": "rule-scheduled-onsite",
      "priority": 0,
      "patternId": "signal-scheduled-onsite",
      "category": "scheduled-onsite",
      "concernLevel": "strong",
      "reason": "scheduled onsite attendance",
      "unlessContains": null,
      "overridePatternId": null,
      "overrideConcernLevel": null,
      "overrideReason": null
    },
    {
      "id": "rule-onsite-duty",
      "priority": 1,
      "patternId": "signal-onsite-duty",
      "category": "onsite-duty",
      "concernLevel": "strong",
      "reason": "onsite duties",
      "unlessContains": null,
      "overridePatternId": "TentativePresencePattern",
      "overrideConcernLevel": "questionable",
      "overrideReason": "periodic or as-needed onsite attendance"
    },
    {
      "id": "rule-field-deployment",
      "priority": 2,
      "patternId": "signal-field-deployment",
      "category": "field-deployment",
      "concernLevel": "strong",
      "reason": "field deployment or operational testing",
      "unlessContains": null,
      "overridePatternId": null,
      "overrideConcernLevel": null,
      "overrideReason": null
    },
    {
      "id": "rule-physical-installation",
      "priority": 3,
      "patternId": "signal-physical-installation",
      "category": "physical-installation",
      "concernLevel": "strong",
      "reason": "physical installation or activation work",
      "unlessContains": null,
      "overridePatternId": null,
      "overrideConcernLevel": null,
      "overrideReason": null
    },
    {
      "id": "rule-operational-site",
      "priority": 4,
      "patternId": "signal-operational-site",
      "category": "operational-site",
      "concernLevel": "strong",
      "reason": "work at an operational site or facility",
      "unlessContains": null,
      "overridePatternId": null,
      "overrideConcernLevel": null,
      "overrideReason": null
    },
    {
      "id": "rule-commuting-area",
      "priority": 5,
      "patternId": "signal-commuting-area",
      "category": "commuting-area",
      "concernLevel": "questionable",
      "reason": "a commuting-distance or local-residency requirement",
      "unlessContains": "airport",
      "overridePatternId": null,
      "overrideConcernLevel": null,
      "overrideReason": null
    }
  ],
  "travelBands": [
    {
      "maximumPercent": 10,
      "category": "occasional-travel",
      "concernLevel": "informational"
    },
    {
      "maximumPercent": 49,
      "category": "moderate-travel",
      "concernLevel": "questionable"
    },
    {
      "maximumPercent": 100,
      "category": "substantial-travel",
      "concernLevel": "strong"
    }
  ],
  "travelReasonTemplate": "{range} travel",
  "frequentTravel": {
    "patternId": "FrequentTravelPattern",
    "category": "frequent-travel",
    "concernLevel": "questionable",
    "reason": "frequent travel"
  }
}
