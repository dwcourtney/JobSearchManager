      "domain": "remote-work",
      "type": "arrangement",
      "pattern": "\\b(?<value>fully\\s+remote|100%\\s+remote|remote|hybrid|on[- ]site|onsite)\\b",
      "code": null,
      "unit": null,
      "kind": "categorical"
    },
    {
