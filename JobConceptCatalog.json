        "\\bLLMs?\\b"
      ]
    },
    {
      "id": "technical.software-development",
      "displayName": "Software Development",
      "category": "Technical Domain",
      "evidencePatterns": [
        "\\bsoftware\\s+(?:development|engineering)\\b",
        "\\bdevelop(?:ing|ment)?\\s+software\\b"
      ]
    },
    {
      "id": "technical.linux",
      "displayName": "Linux",
      "category": "Technical Domain",
      "evidencePatterns": ["\\bLinux\\b"]
    },
    {
      "id": "technical.cloud",
      "displayName": "Cloud Platforms",
      "category": "Technical Domain",
      "evidencePatterns": [
