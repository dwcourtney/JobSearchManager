      "unit": null,
      "kind": "unresolved-name"
    },
    {
      "id": "credentials-acquisition",
      "domain": "credentials",
      "type": "acquisition",
      "pattern": "\\b(?<value>obtain|obtainable|ability\\s+to\\s+obtain|in\\s+progress|progress(?:ing)?\\s+towards?)\\b",
      "code": "acquisition",
      "unit": null,
      "kind": "categorical"
    },
    {
      "id": "credentials-equivalent",
      "domain": "credentials",
      "type": "equivalence",
      "pattern": "\\b(?<value>equivalent\\s+(?:registration|certification|credential|licen[cs]e))\\b",
      "code": "equivalent",
      "unit": null,
      "kind": "categorical"
    },
    {
