      "unit": null,
      "kind": "categorical"
    },
    {
      "id": "education-degree",
      "domain": "education",
      "type": "degree",
      "pattern": "\\b(?<value>Bachelor(?:['\u2019]s|s)?|Master(?:['\u2019]s|s)?|Associate(?:['\u2019]s|s)?|Ph\\.?D\\.?|Doctorate|high\\s+school|GED)\\b",
      "code": null,
      "unit": null,
      "kind": "categorical"
    },
    {
      "id": "education-field",
      "domain": "education",
      "type": "field",
      "pattern": "\\b(?:degree\\s+)?in\\s+(?<value>[A-Za-z][A-Za-z /&-]{0,100}?)(?=\\s+(?:required|preferred|desired|with|plus|and\\s+\\d)|[.;]|$)",
      "code": null,
      "unit": null,
      "kind": "raw-field-list"
    },
    {
      "id": "education-experience",
      "domain": "education",
      "type": "experience",
      "pattern": "(?<lower>\\d+)\\s*(?:[-\u2013]\\s*(?<upper>\\d+)\\s*)?(?<unit>years?)\\s*(?:of\\s+)?(?:relevant\\s+|related\\s+)?experience\\b",
