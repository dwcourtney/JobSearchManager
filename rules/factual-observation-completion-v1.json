      "pattern": "(?<lower>\\d+)\\s*(?<unit>days?)\\s*(?:per\\s+week|a\\s+week|/\\s*week)?\\s*(?:on[- ]?site|in\\s+(?:the\\s+)?office)\\b",
      "code": null,
      "unit": null,
      "kind": "range"
    },
    {
      "id": "remote-percent",
      "domain": "remote-work",
      "type": "travel-percentage",
      "pattern": "\\btravel(?:\\s+(?:(?<bound>up\\s+to)|approximately|between|of))?\\s*(?<lower>\\d+)\\s*(?:%?\\s*(?:[-\u2013]|to|and)\\s*(?<upper>\\d+)\\s*)?%",
      "code": null,
      "unit": "percent",
      "kind": "range"
    },
    {
      "id": "remote-frequency",
      "domain": "remote-work",
      "type": "frequency",
      "pattern": "\\b(?<value>quarterly|monthly|weekly|occasionally|occasional|frequent(?:ly)?|(?:per|each|a)\\s+week)\\b|(?<value>/\\s*week)",
      "code": null,
