    },
    {
      "id": "geography-zone",
      "domain": "geographic-restriction",
      "type": "time-zone",
      "pattern": "\\b(?<value>(?:Eastern|Central|Mountain|Pacific)(?:\\s*[/,]\\s*(?:Eastern|Central|Mountain|Pacific))*)\\s+time\\s+zones?\\b",
      "code": null,
      "unit": null,
      "kind": "surface-zone-list"
    },
    {
      "id": "geography-country",
      "domain": "geographic-restriction",
      "type": "included-jurisdiction",
      "pattern": "\\b(?<value>US[- ]based|U\\.?S\\.?[- ]based|CONUS)(?:\\s*[- ]?only)?\\b",
