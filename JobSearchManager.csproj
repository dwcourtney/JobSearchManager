<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JobSearchManager</RootNamespace>
    <AssemblyName>JobSearchManager</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>assets\JobSearchManager.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="rules/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="CredentialCatalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="CompanyCatalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="JobConceptCatalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="LegacyJobConceptRules.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="RegexValidationCorpus.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="EvaluationHoldoutPlan.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JobSearchManager.Tests" />
    <InternalsVisibleTo Include="Jsm.CheapTriage.Research" />
    <InternalsVisibleTo Include="Jsm.CheapTriage.Research.Tests" />
    <InternalsVisibleTo Include="Jsm.Qwen.Research" />
    <InternalsVisibleTo Include="Jsm.Qwen.Research.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CheapRejectRules.cs;CheapTriageShadow.cs;CheapTriageHumanReview.cs;CheapTriageMaintenance.cs;CheapTriageMaintenanceDetector.cs;RuleMaintenance.cs;TriageEvaluation.cs;JobCatalog.CheapTriage.cs" />
    <Content Remove="CheapTriage/**/*" />
    <None Remove="CheapTriage/**/*" />
    <Compile Remove="ClassifierClient.cs;LlmHoldoutEvaluation.cs;LlmHardwareBenchmark.cs;LlmTechnicalPreflight.cs;research/**/*.cs" />
    <Content Remove="research/**/*;ollama-runtime/**/*;Dockerfile.hardware-benchmark" />
    <None Remove="research/**/*;ollama-runtime/**/*;Dockerfile.hardware-benchmark" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="classifier-service\**\*.cs" />
    <Content Remove="Tests\**\*" />
    <Content Remove="classifier-service\**\*" />
    <None Remove="Tests\**\*" />
    <None Remove="classifier-service\**\*" />
  </ItemGroup>

</Project>
