{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extended-location parsing rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesetVersion",
    "regexTimeoutMilliseconds",
    "patterns",
    "signalRules",
    "destinations",
    "duration",
    "summaries",
    "unspecifiedDestination",
    "strongFallbackSummary",
    "questionableFallbackSummary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rulesetVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "regexTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    },
    "signalRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "patternId",
          "category",
          "confidence",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "patternId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "category": {
            "enum": [
              "explicit-job-location",
              "required-deployment",
              "recurring-deployment",
              "extended-deployment",
              "extended-away-duration",
              "winter-over-assignment",
              "long-term-away-assignment",
              "forward-deployed",
              "oconus-assignment",
              "rotation",
              "temporary-duty",
              "required-unusual-relocation",
              "possible-deployment",
              "possible-extended-assignment"
            ]
          },
          "confidence": {
            "enum": [
              "strong",
              "questionable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "patternId",
          "priority"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "patternId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumDays",
        "category",
        "confidence",
        "reason",
        "numbers",
        "unitPrefixes",
        "defaultDaysPerUnit"
      ],
      "properties": {
        "minimumDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "category": {
          "enum": [
            "explicit-job-location",
            "required-deployment",
            "recurring-deployment",
            "extended-deployment",
            "extended-away-duration",
            "winter-over-assignment",
            "long-term-away-assignment",
            "forward-deployed",
            "oconus-assignment",
            "rotation",
            "temporary-duty",
            "required-unusual-relocation",
            "possible-deployment",
            "possible-extended-assignment"
          ]
        },
        "confidence": {
          "enum": [
            "strong",
            "questionable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "numbers": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "unitPrefixes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          }
        },
        "defaultDaysPerUnit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        }
      }
    },
    "summaries": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "explicit-job-location",
          "required-deployment",
          "recurring-deployment",
          "extended-deployment",
          "extended-away-duration",
          "winter-over-assignment",
          "long-term-away-assignment",
          "forward-deployed",
          "oconus-assignment",
          "rotation",
          "temporary-duty",
          "required-unusual-relocation",
          "possible-deployment",
          "possible-extended-assignment"
        ]
      },
      "minProperties": 1,
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "unspecifiedDestination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "strongFallbackSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "questionableFallbackSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  }
}
