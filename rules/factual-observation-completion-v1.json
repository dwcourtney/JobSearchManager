    },
    {
      "id": "credential-deadline",
      "domain": "credentials",
      "type": "deadline",
      "pattern": "\\bwithin\\s+(?<lower>\\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|ninety)\\s+(?<unit>days?|weeks?|months?|years?)\\b",
